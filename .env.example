# CIVICX Backend Environment Configuration (Example)
# Copy this file to .env and supply your local or production credentials.

# Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./civicx.db

# Security & Session Secrets
SECRET_KEY=your-secure-random-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# LLM / Grounded Copilot Integration (Optional)
GEMINI_API_KEY=

# CORS Configuration (Comma-separated origins for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
