# CIVICX Backend Configuration
PROJECT_NAME="CIVICX"
ENVIRONMENT="development"
PORT=8000

# Database Configuration (PostgreSQL with automatic SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicx_db
# Or SQLite: sqlite:///./civicx.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Simulation & Model Configuration
DEMO_MODE=true
DEMO_CITY="Coimbatore"
DEFAULT_BUDGET=25000000
