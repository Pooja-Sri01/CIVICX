# CIVICX Frontend Environment Configuration (Example)
# Copy this file to .env or .env.local and configure your environment.

# API Base URL (leave empty for same-origin proxy in development)
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API Key (Optional - application gracefully falls back to GIS Vector Engine if omitted)
VITE_GOOGLE_MAPS_API_KEY=

# Application Environment Mode
VITE_APP_ENV=development
